<% can_manage = allowed_to?("customers.manage") %>

<p><%= link_to "← Customers", admin_customers_path, class: "link" %></p>
<h1 class="page-title"><%= @customer.full_name.presence || @customer.email %></h1>

<div class="panel">
  <div class="panel-head"><h2>Profile</h2></div>
  <p>ID: #<%= @customer.id %></p>
  <p>Email: <%= @customer.email %> — <%= @customer.confirmed? ? "verified" : "unverified" %></p>
  <p>Status: <span class="chip <%= @customer.status == "active" ? "ok" : "off" %>"><%= @customer.status %></span></p>
  <p>Joined: <%= @customer.created_at.strftime("%d %b %Y, %H:%M") %></p>
  <p>Phone: <%= @customer.phone.presence || "—" %></p>
  <% if can_manage %>
    <div class="form-actions" style="margin-top:12px;">
      <%= link_to "Edit details", admin_edit_customer_path(@customer), class: "btn-sm" %>
      <%= button_to (@customer.status == "active" ? "Block customer" : "Unblock customer"),
            admin_customer_status_path(@customer), method: :patch, class: "link danger",
            form: { onsubmit: @customer.status == "active" ? "return confirm('Block this customer and revoke their sessions?');" : nil } %>
    </div>
  <% end %>
</div>

<div class="panel">
  <div class="panel-head"><h2>Staff notes</h2></div>
  <% if @notes.empty? %>
    <p class="muted">No notes yet.</p>
  <% else %>
    <ul class="note-list">
      <% @notes.each do |note| %>
        <li class="note-item">
          <div class="note-meta">
            <%= note.admin_user.full_name.presence || note.admin_user.email %>
            · <%= note.created_at.strftime("%d %b %Y, %H:%M") %>
          </div>
          <div><%= simple_format(note.body) %></div>
        </li>
      <% end %>
    </ul>
  <% end %>
  <% if can_manage %>
    <%= form_with url: admin_customer_notes_path(@customer), method: :post do %>
      <div class="form-row">
        <label for="note_body">Add a note</label>
        <textarea id="note_body" name="body" rows="3" maxlength="2000" required placeholder="Visible only to staff."></textarea>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn-sm">Save note</button>
      </div>
    <% end %>
  <% end %>
</div>

<div class="panel">
  <div class="panel-head"><h2>Addresses</h2></div>
  <% if @addresses.empty? %>
    <p class="muted">No saved addresses.</p>
  <% else %>
    <ul>
      <% @addresses.each do |address| %>
        <li>
          <strong><%= address.address_type.capitalize %></strong>
          <% if address.is_default? %><span class="chip ok">Default</span><% end %>
          — <%= address.full_name %>, <%= address.line1 %><%= ", #{address.line2}" if address.line2.present? %>,
          <%= address.city %>, <%= address.state %> <%= address.postal_code %>, <%= address.country %>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>

<%= render "admin/ui/sessions", sessions: @sessions, can_manage: can_manage,
      revoke_all_path: admin_customer_sessions_path(@customer),
      revoke_path: ->(session) { admin_customer_session_path(@customer, session) } %>
