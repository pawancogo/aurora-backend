<%= form_with model: role, url: form_url do |form| %>
  <% if role.errors.any? %>
    <div class="flash flash-alert"><%= role.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="form-row">
    <label>Name</label>
    <%= form.text_field :name, required: true %>
  </div>

  <div class="form-row">
    <label>Key</label>
    <% if role.persisted? %>
      <input type="text" value="<%= role.key %>" disabled>
      <p class="muted-sm">The key is a fixed identifier and can't be changed after creation.</p>
    <% else %>
      <%= form.text_field :key, required: true, placeholder: "e.g. marketing_manager" %>
      <p class="muted-sm">Lowercase letters, numbers and underscores only.</p>
    <% end %>
  </div>

  <div class="form-row">
    <label>Description</label>
    <%= form.text_field :description %>
  </div>

  <div class="form-row">
    <label>Permissions</label>
    <% if role.key == "super_admin" %>
      <p class="muted-sm">Super Admin implicitly holds every permission.</p>
    <% else %>
      <div class="check-grid">
        <%= hidden_field_tag "role[permission_ids][]", "" %>
        <% @permissions.each do |permission| %>
          <label class="check">
            <%= check_box_tag "role[permission_ids][]", permission.id,
                  role.permission_ids.include?(permission.id), id: nil %>
            <span title="<%= permission.description %>"><%= permission.key %></span>
          </label>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="form-actions">
    <%= form.submit submit_label, class: "btn-sm" %>
    <%= link_to "Cancel", admin_settings_roles_path, class: "link" %>
  </div>
<% end %>
