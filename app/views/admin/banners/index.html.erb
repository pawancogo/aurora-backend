<% can_manage = allowed_to?("cms.manage") %>

<h1 class="page-title">Banners</h1>
<p class="page-sub">Hero slides, promo strips, and the header announcement bar. Only <strong>live</strong> banners (visible + within their schedule) appear on the storefront.</p>

<% if can_manage %>
  <div class="toolbar"><%= link_to "+ New banner", new_admin_banner_path, class: "btn-sm" %></div>
<% end %>

<%
  columns = [
    { label: "ID", class: "id-cell", cell: ->(b) { b.id } },
    { label: "Banner", cell: ->(b) {
        thumb = b.image_url.present? ? tag.img(src: b.image_url, class: "list-thumb", loading: "lazy", alt: "") : tag.span(class: "list-thumb-empty")
        content_tag(:span, safe_join([ thumb, b.title.presence || content_tag(:span, "(untitled)", class: "muted") ]), class: "list-cell")
      } },
    { label: "Placement", cell: ->(b) { content_tag(:span, b.placement, class: "opt-chip") } },
    { label: "Live", cell: ->(b) { b.live? ? content_tag(:span, "Live", class: "stock-badge ok") : content_tag(:span, "Off", class: "muted") } },
    { label: "Schedule", cell: ->(b) {
        parts = []
        parts << "from #{b.starts_at.strftime('%b %-d')}" if b.starts_at
        parts << "until #{b.ends_at.strftime('%b %-d')}" if b.ends_at
        parts.any? ? parts.join(" ") : content_tag(:span, "always", class: "muted")
      } }
  ]
  if can_manage
    columns << { label: "", class: "row-actions", cell: ->(b) {
        safe_join([
          link_to("Edit", edit_admin_banner_path(b), class: "link"),
          button_to("Delete", admin_banner_path(b), method: :delete, class: "link danger",
                    form: { onsubmit: "return confirm('Delete this banner?');" })
        ])
      } }
  end
%>
<%= render "admin/ui/table", rows: @banners, columns: columns, empty: "No banners yet." %>
