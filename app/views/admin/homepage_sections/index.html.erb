<% can_manage = allowed_to?("cms.manage") %>

<h1 class="page-title">Homepage</h1>
<p class="page-sub">The building blocks of the storefront homepage, in order. Each block is a type (hero, product row, category grid, text). Only <strong>live</strong> blocks render.</p>

<% if can_manage %>
  <div class="toolbar"><%= link_to "+ New section", new_admin_homepage_section_path, class: "btn-sm" %></div>
<% end %>

<%
  columns = [
    { label: "Pos", class: "id-cell", cell: ->(s) { s.position } },
    { label: "Type", cell: ->(s) { content_tag(:span, s.section_type.humanize, class: "opt-chip") } },
    { label: "Title", cell: ->(s) { s.title.presence || content_tag(:span, "—", class: "muted") } },
    { label: "Settings", cell: ->(s) { s.config_hash.map { |k, v| "#{k}: #{v}" }.join(" · ").presence || content_tag(:span, "—", class: "muted") } },
    { label: "Live", cell: ->(s) { s.live? ? content_tag(:span, "Live", class: "stock-badge ok") : content_tag(:span, "Off", class: "muted") } }
  ]
  if can_manage
    columns << { label: "", class: "row-actions", cell: ->(s) {
        safe_join([
          link_to("Edit", edit_admin_homepage_section_path(s), class: "link"),
          button_to("Delete", admin_homepage_section_path(s), method: :delete, class: "link danger",
                    form: { onsubmit: "return confirm('Delete this section?');" })
        ])
      } }
  end
%>
<%= render "admin/ui/table", rows: @sections, columns: columns, empty: "No homepage sections yet." %>
