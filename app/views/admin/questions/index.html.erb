<h1 class="page-title">Q&amp;A</h1>
<p class="page-sub">Customer questions on product pages. Publish before they appear on the storefront; answer as the store any time.</p>

<%= render "admin/ui/search", url: admin_questions_path, query: params[:q],
      placeholder: "Search questions",
      filters: [
        { name: "status", prompt: "Any status", selected: params[:status],
          options: Array(@facets["status"]).map { |facet| ["#{facet[:label]} (#{facet[:count]})", facet[:value]] } }
      ] %>

<%
  columns = [
    { label: "Question", cell: ->(question) { link_to(truncate(question.body, length: 80), admin_question_path(question)) } },
    { label: "Product", class: "muted-sm", cell: ->(question) { question.product.name } },
    { label: "Customer", class: "muted-sm", cell: ->(question) { question.customer.email } },
    { label: "Status", cell: ->(question) {
        css = question.pending? ? "sys" : (question.hidden? ? "off" : "ok")
        content_tag(:span, question.status.humanize, class: "chip #{css}")
      } },
    { label: "Asked", class: "muted-sm", cell: ->(question) { question.created_at.strftime("%d %b %Y, %H:%M") } }
  ]
%>
<%= render "admin/ui/table", rows: @questions, columns: columns, empty: "No questions." %>

<%= render "admin/ui/pagination", collection: @questions, path: admin_questions_path %>
