<% can_manage = allowed_to?("products.manage") %>

<h1 class="page-title">Attributes</h1>
<p class="page-sub">Option types (Color, Size, …) and their values. Values combine to form product variants; flag an attribute <em>filterable</em> to expose it as a storefront facet.</p>

<% if can_manage %>
  <div class="toolbar">
    <%= link_to "+ New attribute", new_admin_attribute_path, class: "btn-sm" %>
  </div>
<% end %>

<%
  facet_options = ->(key) { Array(@facets[key]).map { |facet| ["#{facet[:label]} (#{facet[:count]})", facet[:value]] } }
%>
<%= render "admin/ui/search", url: admin_attributes_path, query: params[:q],
      placeholder: "Search attributes",
      filters: [
        { name: "filterable", prompt: "Any (filterable)", selected: params[:filterable], options: facet_options.call("filterable") },
        { name: "searchable", prompt: "Any (searchable)", selected: params[:searchable], options: facet_options.call("searchable") }
      ] %>

<%
  columns = [
    { label: "ID", class: "id-cell", cell: ->(attr) { attr.id } },
    { label: "Attribute", cell: ->(attr) { content_tag(:strong, attr.name) } },
    { label: "Code", cell: ->(attr) { content_tag(:code, attr.code) } },
    { label: "Values", cell: ->(attr) {
        vals = attr.attribute_values.first(8).map(&:value)
        more = attr.attribute_values.size - vals.size
        text = vals.join(", ")
        text += " +#{more} more" if more.positive?
        text.presence || content_tag(:span, "—", class: "muted")
      } },
    { label: "Filterable", cell: ->(attr) { attr.filterable? ? "✓" : "—" } },
    { label: "Searchable", cell: ->(attr) { attr.searchable? ? "✓" : "—" } }
  ]
  if can_manage
    columns << { label: "", class: "row-actions", cell: ->(attr) {
        safe_join([
          link_to("Edit", edit_admin_attribute_path(attr), class: "link"),
          button_to("Delete", admin_attribute_path(attr), method: :delete, class: "link danger",
                    form: { onsubmit: "return confirm('Delete attribute “#{attr.name}”?');" })
        ])
      } }
  end
%>
<%= render "admin/ui/table", rows: @attributes, columns: columns, empty: "No attributes yet." %>

<%= render "admin/ui/pagination", collection: @attributes, path: admin_attributes_path %>
