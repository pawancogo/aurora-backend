<p><%= link_to "← Roadmap", admin_sprints_path(anchor: "sprint-#{@sprint.id}"), class: "link" %></p>
<h1 class="page-title">New feature</h1>
<p class="page-sub">Sprint #<%= @sprint.number %> · <%= @sprint.title %></p>

<%= render "form", feature: @feature, sprint: @sprint, form_url: admin_sprint_features_path(@sprint),
      form_method: :post, submit_label: "Add feature" %>
