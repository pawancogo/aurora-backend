<% can_manage = allowed_to?("products.manage") %>

<p><%= link_to "← Edit product", edit_admin_product_path(@product), class: "link" %></p>
<h1 class="page-title">Variants — <%= @product.name %></h1>
<p class="page-sub">
  ID #<%= @product.id %> · Each variant is a unique option combination with its own SKU, price and stock.
  The product's base price applies when a variant leaves price blank.
</p>

<% if can_manage %>
  <div class="toolbar">
    <%= link_to "+ New variant", new_admin_product_variant_path(@product), class: "btn-sm" %>
  </div>
<% end %>

<%
  columns = [
    { label: "ID", class: "id-cell", cell: ->(v) { v.id } },
    { label: "Options", cell: ->(v) { variant_option_chips(v) } },
    { label: "SKU",     cell: ->(v) { content_tag(:code, v.sku) } },
    { label: "Price",   cell: ->(v) { "₹#{number_with_delimiter(v.price.round)}" } },
    { label: "Stock",   cell: ->(v) { stock_badge(v.inventory_item) } },
    { label: "Active",  cell: ->(v) { v.active? ? "✓" : "—" } }
  ]
  if can_manage
    columns << { label: "", class: "row-actions", cell: ->(v) {
        safe_join([
          link_to("Edit", edit_admin_product_variant_path(@product, v), class: "link"),
          link_to("Stock", admin_inventory_item_path(v), class: "link"),
          button_to("Delete", admin_product_variant_path(@product, v), method: :delete, class: "link danger",
                    form: { onsubmit: "return confirm('Delete this variant?');" })
        ])
      } }
  end
%>
<%= render "admin/ui/table", rows: @variants, columns: columns,
      empty: "No variants yet — this product sells as a single item at its base price." %>
