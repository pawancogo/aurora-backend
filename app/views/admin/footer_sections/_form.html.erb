<%= form_with model: section, url: form_url, method: form_method do |form| %>
  <% if section.errors.any? %>
    <div class="flash flash-alert"><%= section.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="admin-form-grid" style="max-width:640px;">
    <div class="form-row">
      <label>Heading</label>
      <%= form.text_field :heading, required: true, placeholder: "e.g. Company" %>
    </div>
    <div class="form-row">
      <label>Position</label>
      <%= form.number_field :position, value: section.position || 0 %>
    </div>
  </div>

  <div class="check-grid" style="max-width:640px;">
    <label class="check"><%= form.check_box :visible %> Visible</label>
  </div>

  <h2 class="panel-title" style="margin-top:24px;">Links</h2>
  <div class="attr-values" data-links>
    <% Array(section.link_items).each do |link| %>
      <div class="attr-value-row spec-row" data-link-row>
        <input type="text" name="footer_section[links][][label]" value="<%= link["label"] %>" placeholder="Label (e.g. About us)" class="attr-value-input" />
        <input type="text" name="footer_section[links][][url]" value="<%= link["url"] %>" placeholder="URL (e.g. /p/about)" class="attr-value-input" />
        <span></span>
        <button type="button" class="row-remove" data-remove-row aria-label="Remove link" title="Remove">✕</button>
      </div>
    <% end %>
  </div>
  <template data-link-template>
    <div class="attr-value-row spec-row" data-link-row>
      <input type="text" name="footer_section[links][][label]" placeholder="Label (e.g. About us)" class="attr-value-input" />
      <input type="text" name="footer_section[links][][url]" placeholder="URL (e.g. /p/about)" class="attr-value-input" />
      <span></span>
      <button type="button" class="row-remove" data-remove-row aria-label="Remove link" title="Remove">✕</button>
    </div>
  </template>
  <p><button type="button" class="btn-ghost" data-add-link>+ Add link</button></p>
  <script>
    (function () {
      var addBtn = document.querySelector("[data-add-link]");
      var tpl = document.querySelector("[data-link-template]");
      var container = document.querySelector("[data-links]");
      if (addBtn && tpl && container) {
        addBtn.addEventListener("click", function () {
          container.insertAdjacentHTML("beforeend", tpl.innerHTML);
        });
      }
      document.addEventListener("click", function (event) {
        var btn = event.target.closest("[data-remove-row]");
        if (btn && btn.closest("[data-link-row]")) btn.closest("[data-link-row]").remove();
      });
    })();
  </script>

  <div class="form-actions">
    <%= form.submit submit_label, class: "btn-sm" %>
    <%= link_to "Cancel", admin_footer_sections_path, class: "link" %>
  </div>
<% end %>
