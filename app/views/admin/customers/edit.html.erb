<p><%= link_to "← Back to customer", admin_customer_path(@customer), class: "link" %></p>
<h1 class="page-title">Edit customer</h1>
<p class="page-sub">ID #<%= @customer.id %> · Update contact details. Email changes go through the customer's own verified flow.</p>

<%= form_with model: @customer, url: admin_customer_path(@customer), method: :patch do |form| %>
  <% if @customer.errors.any? %>
    <div class="flash flash-alert"><%= @customer.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="form-row">
    <label>Email</label>
    <input type="text" value="<%= @customer.email %>" disabled>
    <p class="muted-sm">Read-only — the customer manages their own email and verification.</p>
  </div>

  <div class="admin-form-grid" style="max-width:640px;">
    <div class="form-row">
      <label>First name</label>
      <%= form.text_field :first_name %>
    </div>
    <div class="form-row">
      <label>Last name</label>
      <%= form.text_field :last_name %>
    </div>
  </div>

  <div class="form-row">
    <label>Phone</label>
    <%= form.text_field :phone %>
  </div>

  <div class="form-actions">
    <%= form.submit "Save changes", class: "btn-sm" %>
    <%= link_to "Cancel", admin_customer_path(@customer), class: "link" %>
  </div>
<% end %>
