<%#
  Shared sprint body — goal, facts, and the full feature list with both
  description sections. Used by both the index accordion (inline expand)
  and the dedicated show page (direct-linkable detail view).
  Locals: sprint, can_manage.
%>
<p class="sprint-goal">
  <%= sprint.goal.presence || content_tag(:span, "No goal set.", class: "muted-sm") %>
</p>
<div class="sprint-facts">
  <span>Dependencies: <%= sprint.dependencies.presence || "—" %></span>
  <span>Estimate: <%= sprint.estimate.presence || "—" %></span>
  <% if sprint.started_on %><span>Started <%= sprint.started_on.strftime("%d %b %Y") %></span><% end %>
  <% if sprint.completed_on %><span>Completed <%= sprint.completed_on.strftime("%d %b %Y") %></span><% end %>
</div>

<% sprint.sprint_features.each do |feature| %>
  <div class="feature-row">
    <div class="feature-head">
      <span>
        <span class="opt-chip"><%= feature.area.humanize %></span>
        <span class="feature-title"><%= feature.title %></span>
      </span>
      <% if can_manage %>
        <span class="row-actions">
          <%= link_to "Edit", edit_admin_sprint_feature_path(sprint, feature), class: "link" %>
          <%= button_to "Delete", admin_sprint_feature_path(sprint, feature), method: :delete, class: "link danger",
                form: { onsubmit: "return confirm('Delete this feature?');" } %>
        </span>
      <% end %>
    </div>
    <div class="feature-body">
      <p class="feature-body-label">What it does</p>
      <%= sanitized_rich_text(feature.description) %>
    </div>
    <% if feature.technical_description.present? %>
      <div class="feature-body feature-body-tech">
        <p class="feature-body-label">Technical details</p>
        <%= sanitized_rich_text(feature.technical_description) %>
      </div>
    <% end %>
  </div>
<% end %>

<% if sprint.sprint_features.empty? %>
  <p class="muted-sm">No features logged yet.</p>
<% end %>

<% if can_manage %>
  <%= link_to "+ Add feature", new_admin_sprint_feature_path(sprint), class: "link" %>
<% end %>
