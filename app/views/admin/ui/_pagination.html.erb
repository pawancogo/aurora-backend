<%#
  Reusable pager for a Kaminari collection. Always shows the total item count
  ("Showing X–Y of N"); prev/next appear only when there's more than one page.
  Carries all current query params (search, filters, …) across page links.
  Locals:
    collection : a Kaminari-paginated relation.
    path       : base path for the links.
  Render with: render "admin/ui/pagination", collection: @products, path: admin_products_path
%>
<% if collection.respond_to?(:total_count) %>
  <% carry = request.query_parameters.except("page") %>
  <% total = collection.total_count %>
  <% from = total.zero? ? 0 : collection.offset_value + 1 %>
  <% to = [ collection.offset_value + collection.limit_value, total ].min %>
  <div class="pager">
    <span class="muted-sm">
      <% if total.zero? %>
        No items
      <% else %>
        Showing <%= from %>–<%= to %> of <%= total %> item<%= "s" unless total == 1 %>
      <% end %>
    </span>

    <% if collection.total_pages > 1 %>
      <span class="pager-nav">
        <% if collection.prev_page %>
          <%= link_to "Previous", "#{path}?#{carry.merge('page' => collection.prev_page).to_query}", class: "btn-ghost" %>
        <% end %>
        <span class="muted-sm">Page <%= collection.current_page %> of <%= collection.total_pages %></span>
        <% if collection.next_page %>
          <%= link_to "Next", "#{path}?#{carry.merge('page' => collection.next_page).to_query}", class: "btn-ghost" %>
        <% end %>
      </span>
    <% end %>
  </div>
<% end %>
