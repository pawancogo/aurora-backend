<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Aurora Admin</title>
    <%= csrf_meta_tags %>
    <%= render "admin/styles" %>
  </head>
  <body class="admin-body">
    <aside class="sidebar">
      <div class="brand">AURORA <span>Admin</span></div>
      <nav>
        <a class="nav-link <%= "active" if controller_name == "dashboard" %>" href="<%= admin_root_path %>">Dashboard</a>

        <div class="nav-section">Catalog</div>
        <a class="nav-link <%= "active" if controller_name == "products" || controller_name == "product_relations" %>" href="<%= admin_products_path %>">Products</a>
        <a class="nav-link <%= "active" if controller_name == "variants" || controller_name == "product_variants" %>" href="<%= admin_variants_path %>">Variants</a>
        <a class="nav-link <%= "active" if controller_name == "categories" %>" href="<%= admin_categories_path %>">Categories</a>
        <a class="nav-link <%= "active" if controller_name == "brands" %>" href="<%= admin_brands_path %>">Brands</a>
        <a class="nav-link <%= "active" if controller_name == "attributes" %>" href="<%= admin_attributes_path %>">Attributes</a>

        <div class="nav-section">Operations</div>
        <a class="nav-link <%= "active" if controller_name == "inventory" %>" href="<%= admin_inventory_path %>">Inventory</a>
        <a class="nav-link <%= "active" if controller_name == "customers" %>" href="<%= admin_customers_path %>">Customers</a>
        <a class="nav-link <%= "active" if controller_name == "orders" %>" href="<%= admin_orders_path %>">Orders</a>
        <% if allowed_to?("settings.manage") %>
          <a class="nav-link <%= "active" if controller_name == "payment_settings" %>" href="<%= admin_payment_settings_path %>">Payment settings</a>
        <% end %>

        <% if allowed_to?("cms.read") %>
          <div class="nav-section">Content</div>
          <a class="nav-link <%= "active" if controller_name == "homepage_sections" %>" href="<%= admin_homepage_sections_path %>">Homepage</a>
          <a class="nav-link <%= "active" if controller_name == "banners" %>" href="<%= admin_banners_path %>">Banners</a>
          <a class="nav-link <%= "active" if controller_name == "static_pages" %>" href="<%= admin_static_pages_path %>">Pages</a>
          <a class="nav-link <%= "active" if controller_name == "footer_sections" %>" href="<%= admin_footer_sections_path %>">Footer</a>
        <% end %>

        <% if allowed_to?("roadmap.read") %>
          <div class="nav-section">Roadmap</div>
          <a class="nav-link <%= "active" if %w[sprints sprint_features].include?(controller_name) %>" href="<%= admin_sprints_path %>">Sprints</a>
        <% end %>

        <div class="nav-section">Admin</div>
        <a class="nav-link <%= "active" if %w[settings roles].include?(controller_name) %>" href="<%= admin_settings_path %>">Settings</a>
      </nav>
    </aside>

    <div class="main">
      <header class="topbar">
        <div></div>
        <% menu_name = current_admin_user.full_name.presence || current_admin_user.email %>
        <div class="topbar-right">
          <% if current_admin_user.super_admin? %>
            <a class="topbar-link" href="/superadmin" target="_blank" rel="noopener">Data Console ↗</a>
          <% end %>
          <details class="user-menu">
          <summary class="avatar" aria-label="Account menu" aria-haspopup="menu">
            <%= menu_name.to_s.split(/\s+/).first(2).filter_map { |part| part[0] }.join.upcase %>
          </summary>
          <div class="user-menu-panel" role="menu">
            <div class="user-menu-head">
              <p class="user-menu-name"><%= menu_name %></p>
              <p class="user-menu-email"><%= current_admin_user.email %></p>
            </div>
            <div class="user-menu-info">
              <span>Roles: <%= current_admin_user.roles.map(&:name).join(", ").presence || "—" %></span>
              <span><%= current_admin_user.permission_keys.size %> permission(s)</span>
            </div>
            <div class="user-menu-foot">
              <%= button_to "Sign out", admin_logout_path, method: :delete, class: "user-menu-signout" %>
            </div>
          </div>
          </details>
        </div>
      </header>

      <main class="content">
        <% flash.each do |type, message| %>
          <div class="flash flash-<%= type %>"><%= message %></div>
        <% end %>
        <%= yield %>
      </main>
    </div>

    <script>
      document.addEventListener("click", function (event) {
        // Close the account dropdown when clicking outside it.
        document.querySelectorAll("details.user-menu[open]").forEach(function (menu) {
          if (!menu.contains(event.target)) menu.removeAttribute("open");
        });

        // Reusable modal (admin/ui/_modal): open/close the native <dialog>.
        var opener = event.target.closest("[data-modal-open]");
        if (opener) {
          document.getElementById(opener.getAttribute("data-modal-open"))?.showModal();
          return;
        }
        if (event.target.closest("[data-modal-close]")) {
          event.target.closest("dialog")?.close();
          return;
        }
        // Click on the backdrop (the dialog element itself) closes it.
        if (event.target.matches("dialog.ui-modal")) event.target.close();

        // Reusable rich-text editor (admin/ui/_richtext): toolbar commands.
        var cmdBtn = event.target.closest("[data-richtext-cmd]");
        if (cmdBtn) {
          event.preventDefault();
          var editor = cmdBtn.closest(".richtext").querySelector("[data-richtext-input]");
          editor.focus();
          var cmd = cmdBtn.dataset.richtextCmd;
          var value = cmdBtn.dataset.richtextValue || null;
          if (cmd === "createLink") {
            var url = window.prompt("Link URL:");
            if (!url) return;
            value = url;
          }
          document.execCommand(cmd, false, value);
        }
      });

      // Sprint accordion (admin/sprints#index): reopen the sprint named by the
      // URL hash after a create/update/destroy redirect, instead of losing
      // the user's place and dropping them back at a fully collapsed list.
      document.addEventListener("DOMContentLoaded", function () {
        if (!location.hash) return;
        var target = document.getElementById(location.hash.slice(1));
        if (target && target.tagName === "DETAILS") target.setAttribute("open", "");
      });

      // Reusable rich-text editor: force plain-text paste (no pasted-in HTML/styles).
      document.addEventListener("paste", function (event) {
        if (!event.target.closest || !event.target.closest("[data-richtext-input]")) return;
        event.preventDefault();
        document.execCommand("insertText", false, event.clipboardData.getData("text/plain"));
      });

      // Reusable rich-text editor: sync contenteditable HTML into its hidden
      // field right before the form actually submits.
      document.addEventListener("submit", function (event) {
        event.target.querySelectorAll(".richtext").forEach(function (rt) {
          var editor = rt.querySelector("[data-richtext-input]");
          var hidden = rt.querySelector("[data-richtext-hidden]");
          if (editor && hidden) hidden.value = editor.innerHTML;
        });
      });
    </script>
    <%= render "admin/ui/select_enhancer" %>
    <%= render "admin/ui/uploader_script" %>
    <%= render "admin/ui/image_preview_script" %>
  </body>
</html>
