<%= form_with model: attribute, url: form_url, method: form_method do |form| %>
  <% if attribute.errors.any? %>
    <div class="flash flash-alert"><%= attribute.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="admin-form-grid" style="max-width:640px;">
    <div class="form-row">
      <label>Name</label>
      <%= form.text_field :name, required: true, placeholder: "e.g. Color" %>
    </div>
    <div class="form-row">
      <label>Code</label>
      <%= form.text_field :code, placeholder: "Auto-generated from the name if blank" %>
    </div>
  </div>

  <div class="check-grid" style="max-width:640px;">
    <label class="check"><%= form.check_box :filterable %> Filterable (show as a storefront facet)</label>
    <label class="check"><%= form.check_box :searchable %> Searchable</label>
  </div>

  <div class="form-row" style="max-width:200px;">
    <label>Position</label>
    <%= form.number_field :position, value: attribute.position || 0 %>
  </div>

  <h2 class="panel-title" style="margin-top:24px;">Values</h2>
  <p class="page-sub">Each value can become part of a variant (e.g. Red, Blue). The code auto-fills from the value.</p>

  <div class="attr-values" data-values>
    <%= form.fields_for :attribute_values do |value_fields| %>
      <div class="attr-value-row" data-value-row>
        <%= value_fields.text_field :value, placeholder: "Value (e.g. Red)", class: "attr-value-input" %>
        <%= value_fields.text_field :code, placeholder: "code (optional)", class: "attr-value-code" %>
        <%= value_fields.number_field :position, placeholder: "Pos", class: "attr-value-pos", value: value_fields.object&.position || 0 %>
        <% if value_fields.object&.persisted? %>
          <%= value_fields.hidden_field :_destroy, data: { destroy_flag: "" } %>
        <% end %>
        <button type="button" class="row-remove" data-remove-row aria-label="Remove value" title="Remove">✕</button>
      </div>
    <% end %>
  </div>

  <template data-value-template>
    <div class="attr-value-row" data-value-row>
      <input type="text" name="product_attribute[attribute_values_attributes][NEW_RECORD][value]" placeholder="Value (e.g. Red)" class="attr-value-input" />
      <input type="text" name="product_attribute[attribute_values_attributes][NEW_RECORD][code]" placeholder="code (optional)" class="attr-value-code" />
      <input type="number" name="product_attribute[attribute_values_attributes][NEW_RECORD][position]" placeholder="Pos" class="attr-value-pos" value="0" />
      <button type="button" class="row-remove" data-remove-row aria-label="Remove value" title="Remove">✕</button>
    </div>
  </template>

  <p><button type="button" class="btn-ghost" data-add-value>+ Add value</button></p>

  <div class="form-actions">
    <%= form.submit submit_label, class: "btn-sm" %>
    <%= link_to "Cancel", admin_attributes_path, class: "link" %>
  </div>
<% end %>

<script>
  (function () {
    var addBtn = document.querySelector("[data-add-value]");
    var tpl = document.querySelector("[data-value-template]");
    var container = document.querySelector("[data-values]");
    if (addBtn && tpl && container) {
      addBtn.addEventListener("click", function () {
        container.insertAdjacentHTML("beforeend", tpl.innerHTML.replace(/NEW_RECORD/g, String(Date.now())));
      });
    }
    // Remove a value row: persisted rows are marked for deletion (_destroy) and
    // hidden; unsaved rows are just dropped from the DOM.
    document.addEventListener("click", function (event) {
      var btn = event.target.closest("[data-remove-row]");
      if (!btn) return;
      var row = btn.closest("[data-value-row]");
      if (!row) return;
      var flag = row.querySelector("[data-destroy-flag]");
      if (flag) { flag.value = "1"; row.style.display = "none"; } else { row.remove(); }
    });
  })();
</script>
